+
+    // MARK: - Foreground CGM Polling (Dexcom Share + Pump Simulator)
+
+    private var foregroundRefreshTimer: Timer?
+    private var isRefreshingCGM = false
+
+    private var isEligibleForForegroundPolling: Bool {
+        return cgmManager?.pluginIdentifier == "DexShareClient" &&
+               pumpManager?.pluginIdentifier == "MockPumpManager"
+    }
+
+    private func evaluateForegroundRefreshTimer(triggerImmediate: Bool = false) {
+        dispatchPrecondition(condition: .onQueue(.main))
+
+        guard isEligibleForForegroundPolling && UIApplication.shared.applicationState == .active else {
+            stopForegroundRefreshTimer()
+            return
+        }
+
+        if triggerImmediate {
+            log.default("Triggering immediate CGM refresh on active")
+            performForegroundRefresh()
+        }
+
+        guard foregroundRefreshTimer == nil else { return }
+
+        log.default("Starting 2-minute foreground refresh timer for DexShareClient + MockPumpManager")
+        foregroundRefreshTimer = Timer.scheduledTimer(withTimeInterval: 120, repeats: true) { [weak self] _ in
+            guard let self = self else { return }
+            self.log.default("Foreground refresh timer fired: refreshing CGM")
+            self.performForegroundRefresh()
+        }
+    }
+
+    private func performForegroundRefresh() {
+        dispatchPrecondition(condition: .onQueue(.main))
+        guard !isRefreshingCGM else {
+            log.default("Foreground refresh already in progress, skipping")
+            return
+        }
+
+        isRefreshingCGM = true
+        refreshCGM { [weak self] in
+            DispatchQueue.main.async {
+                self?.isRefreshingCGM = false
+            }
+        }
+    }
+
+    private func stopForegroundRefreshTimer() {
+        dispatchPrecondition(condition: .onQueue(.main))
+        if foregroundRefreshTimer != nil {
+            log.default("Stopping foreground refresh timer")
+            foregroundRefreshTimer?.invalidate()
+            foregroundRefreshTimer = nil
+        }
+    }
 }
 
